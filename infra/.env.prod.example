# Copy to infra/.env.prod on the server and fill in. Never commit the real file.

# The address Caddy serves. A bare domain turns on automatic HTTPS.
SITE_ADDRESS=tapwear.example.com
# The same address as a full URL, used in links, emails and the browser bundle.
SITE_URL=https://tapwear.example.com

# Database. Use a long random password.
POSTGRES_USER=tapwear
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tapwear

# Object storage for product photos. Use long random values.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Email. "console" only writes messages to the API log: registration
# confirmation and password reset will not reach people until SMTP is configured.
EMAIL_BACKEND=console
EMAIL_FROM=TapWear <no-reply@tapwear.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
