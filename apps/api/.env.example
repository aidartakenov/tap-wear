# Copy to apps/api/.env and adjust. Values below match the defaults in infra/docker-compose.yml.

ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://tapwear:tapwear_password@localhost:5432/tapwear_db

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_ASSETS=tapwear-assets
MINIO_BUCKET_SEARCH_QUERIES=tapwear-search-queries

EMBEDDING_MODEL_NAME=clip-ViT-B-32
EMBEDDING_DIMENSIONS=512

STORAGE_PUBLIC_URL=http://localhost:9000

# Local test accounts created by `python -m app.seed_dev`. For local development
# only: the command refuses to run when ENVIRONMENT is not "local".
DEV_ADMIN_EMAIL=admin@tapwear.local
DEV_ADMIN_PASSWORD=local-admin-password
DEV_SELLER_EMAIL=seller@tapwear.local
DEV_SELLER_PASSWORD=local-seller-password
