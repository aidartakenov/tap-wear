# Copy to apps/api/.env and adjust. Values below match the defaults in infra/docker-compose.yml.

ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://topwear:topwear_password@localhost:5432/topwear_db

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_ASSETS=topwear-assets
MINIO_BUCKET_SEARCH_QUERIES=topwear-search-queries

EMBEDDING_MODEL_NAME=clip-ViT-B-32
EMBEDDING_DIMENSIONS=512
